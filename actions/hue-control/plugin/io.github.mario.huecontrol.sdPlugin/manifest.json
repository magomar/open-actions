{
  "Name": "Hue Control",
  "Author": "mario",
  "Version": "0.1.0",
  "Category": "Philips Hue",
  "Icon": "icon",
  "OS": [{ "Platform": "linux" }, { "Platform": "mac" }],
  "CodePathLin": "hue-control",
  "CodePathMac": "hue-control",
  "PropertyInspectorPath": "pi/index.html",
  "Actions": [
    {
      "UUID": "io.github.mario.huecontrol.switch",
      "Name": "Switch",
      "Icon": "actions/power",
      "Tooltip": "Toggle a Hue light or group on/off",
      "Controllers": ["Keypad"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    },
    {
      "UUID": "io.github.mario.huecontrol.color",
      "Name": "Color",
      "Icon": "actions/color",
      "Tooltip": "Set a fixed color or cycle through a color palette",
      "Controllers": ["Keypad"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    },
    {
      "UUID": "io.github.mario.huecontrol.brightness",
      "Name": "Brightness",
      "Icon": "actions/brightness",
      "Tooltip": "Set a brightness level or cycle through brightness steps",
      "Controllers": ["Keypad", "Encoder"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    },
    {
      "UUID": "io.github.mario.huecontrol.temperature",
      "Name": "Temperature",
      "Icon": "actions/temperature",
      "Tooltip": "Set color temperature or cycle through temperature presets",
      "Controllers": ["Keypad", "Encoder"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    },
    {
      "UUID": "io.github.mario.huecontrol.scene",
      "Name": "Scene",
      "Icon": "actions/scene",
      "Tooltip": "Apply a scene or cycle through scenes",
      "Controllers": ["Keypad"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    }
  ]
}
