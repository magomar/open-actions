{
  "Name": "GPU Screen Recorder",
  "Author": "mario",
  "Version": "0.1.0",
  "Category": "GPU Screen Recorder",
  "Icon": "icon",
  "OS": [{ "Platform": "linux" }],
  "CodePathLin": "open-actions-gsr",
  "PropertyInspectorPath": "pi/index.html",
  "Actions": [
    {
      "UUID": "io.github.mario.gpuscreenrecorder.record-screen",
      "Name": "Record Screen",
      "Icon": "actions/record-screen",
      "Tooltip": "Toggle GPU Screen Recorder whole-screen recording",
      "Controllers": ["Keypad"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    },
    {
      "UUID": "io.github.mario.gpuscreenrecorder.record-window",
      "Name": "Record Window",
      "Icon": "actions/record-window",
      "Tooltip": "Toggle GPU Screen Recorder focused-window recording",
      "Controllers": ["Keypad"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    },
    {
      "UUID": "io.github.mario.gpuscreenrecorder.toggle-daemon",
      "Name": "Toggle Background Service",
      "Icon": "actions/toggle-daemon",
      "Tooltip": "Start or kill the GPU Screen Recorder background process",
      "Controllers": ["Keypad"],
      "States": [{ "Title": "", "TitleAlignment": "middle", "FontStyle": "Bold" }]
    }
  ]
}
